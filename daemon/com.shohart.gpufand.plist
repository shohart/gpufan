<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.shohart.gpufand</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/sbin/gpufand</string>
		<string>-c</string>
		<string>/usr/local/etc/gpufand.conf</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/var/log/gpufand.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/gpufand.log</string>
</dict>
</plist>
