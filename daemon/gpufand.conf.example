# gpufand — образец конфигурации.
# Рабочий файл: /usr/local/etc/gpufand.conf, обычно его создаёт `sudo gpufan setup`.
# Применить правки без перезапуска службы:
#   sudo launchctl kill HUP system/com.shohart.gpufand

# Каналы, которыми управляет служба. Номера — из `gpufan` (столбец «№»).
# Какой канал что крутит, показывает `sudo gpufan scan`.
fans = 1

# Источники температуры: КЛЮЧ[,КЛЮЧ...] : T°C:скважность% ...
# По нескольким ключам в одной строке берётся самый горячий.
# По нескольким строкам берётся наибольшая скважность — поэтому вентиляторы
# реагируют и на процессор, и на видеокарту.
# Между точками — линейная интерполяция; за краями кривая не продолжается.
# Список доступных ключей: `gpufan sensors -a`.
source = TC0P : 55:30 85:100
source = TG0D,TGDD : 45:30 80:100

interval   = 2     # период опроса датчиков, с
min_duty   = 30    # нижний предел скважности, % — ниже многие вентиляторы не трогаются
fail_duty  = 100   # если датчики источника не читаются fail_limit циклов подряд
fail_limit = 3
down_step  = 2     # насколько снижать скважность за цикл, % — чтобы не дёргать обороты
hysteresis = 3     # на сколько °C остыть, прежде чем сбавлять
